<% content_for(:title) { 'Edit Plan' } %>
<div class="patra-panel-kit" style="padding: 24px;">
  <h1 style="margin: 0 0 4px; font-size: 22px;">Edit plan: <%= @plan.name %></h1>
  <div class="muted" style="font-size: 13px; margin-bottom: 16px;"><%= @plan.accounts.count %> account(s) currently on this plan.</div>
  <div class="patra-panel" style="max-width: 820px;">
    <%= render 'form', plan: @plan, url: super_admin_patra_plan_path(@plan), method: :patch %>
  </div>
</div>

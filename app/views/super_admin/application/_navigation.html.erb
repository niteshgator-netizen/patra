<%#
# Navigation

This partial is used to display the navigation in Administrate.
By default, the navigation contains navigation links
for all resources in the admin dashboard,
as defined by the routes in the `admin/` namespace
%>

<%= vite_client_tag %>
<%= vite_javascript_tag 'superadmin_pages' %>

<%
  sidebar_icons = {
    accounts: 'icon-building-4-line',
    users: 'icon-user-follow-line',
    platform_apps: 'icon-apps-2-line',
    agent_bots: 'icon-robot-line',
    platform_banners: 'icon-megaphone-line',
  }
%>

<div class="border-slate-100 border-r w-56 flex-shrink-0 justify-between h-full flex flex-col" role="navigation">
  <div>
    <%# PATRA TAB-C (ADM4): prominent impersonation indicator + one-click exit %>
    <% if respond_to?(:patra_impersonation_active?) && patra_impersonation_active? %>
      <div style="background:#dc2626;color:#fff;padding:10px 12px;font-size:12px;">
        <strong>IMPERSONATION ACTIVE</strong><br/>
        user #<%= patra_impersonation[:target_user_id] %> · expires <%= patra_impersonation[:expires_at] %>
        <%= form_with url: super_admin_patra_impersonation_path, method: :delete, local: true do %>
          <button type="submit" style="margin-top:6px;background:#fff;color:#dc2626;border:none;border-radius:6px;padding:4px 10px;font-weight:700;cursor:pointer;">EXIT impersonation</button>
        <% end %>
      </div>
    <% end %>
    <div class="flex mx-4 mb-4 border-slate-100 border-b py-6">
      <%= link_to super_admin_root_url, class: 'block', 'aria-label': 'Patra Admin Dashboard' do %>
        <svg width="40" height="40" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
          <circle cx="50" cy="50" r="50" fill="var(--patra, #6E56CF)"/>
          <text x="50" y="68" font-family="'Space Grotesk',Arial,sans-serif" font-size="60" font-weight="700" fill="white" text-anchor="middle">P</text>
        </svg>
      <% end %>
      <div class="flex flex-col ml-3">
        <div class="text-sm">Patra 1.0</div>
        <div class="text-xs text-slate-700 mt-0.5">Super Admin Console</div>
      </div>
    </div>

    <div class="patra-nav-section">Patra</div>
    <ul class="mb-2">
      <%# PATRA TAB-C: operator console links %>
      <%= render partial: "nav_item", locals: { icon: 'icon-dashboard-line', url: super_admin_patra_dashboard_path, label: 'Command Center' } %>
      <%= render partial: "nav_item", locals: { icon: 'icon-apps-2-line', url: super_admin_patra_plans_path, label: 'Plans & Pricing' } %>
      <%= render partial: "nav_item", locals: { icon: 'icon-grid-line', url: super_admin_patra_feature_gating_path, label: 'Feature Gating' } %>
      <%= render partial: "nav_item", locals: { icon: 'icon-robot-line', url: super_admin_patra_game_health_path, label: 'Game Health' } %>
      <%= render partial: "nav_item", locals: { icon: 'icon-health-book-line', url: super_admin_patra_admin_audit_logs_path, label: 'Audit Trail' } %>
      <%# patra-final 5e (G44): cross-account player search (read-only) %>
      <%= render partial: "nav_item", locals: { icon: 'icon-user-follow-line', url: super_admin_patra_players_path, label: 'Player Search' } %>
    </ul>
    <div class="patra-nav-section">Platform</div>
    <ul class="mb-2">
      <%= render partial: "nav_item", locals: { icon: 'icon-grid-line', url: super_admin_root_url, label: 'Overview' } %>
      <% Administrate::Namespace.new(namespace).resources.each do |resource| %>
        <% next if ["account_users", "access_tokens", "installation_configs", "dashboard", "devise/sessions", "app_configs", "instance_statuses", "settings", "push_diagnostics", "agent_bots", "platform_apps", "patra_dashboard", "feature_flags", "patra_admin_audit_logs", "patra_accounts", "patra_game_health", "patra_impersonations", "patra_plans", "patra_feature_gating", "patra_players"].include?  resource.resource %>
        <% next if resource.resource == "platform_banners" && !ChatwootApp.chatwoot_cloud? %>
        <%= render partial: "nav_item", locals: {
            icon: sidebar_icons[resource.resource.to_sym],
            url: resource_index_route(resource),
            label: display_resource_name(resource),
          }
        %>

      <% end %>
      <%= render 'settings_menu', open: settings_open? %>
    </ul>
  </div>
  <div>
    <div class="patra-nav-section">Utilities</div>
    <ul class="my-2">
      <%= render partial: "nav_item", locals: { icon: 'icon-mist-fill', url: sidekiq_web_url, label: 'Sidekiq Dashboard' } %>
      <%= render partial: "nav_item", locals: { icon: 'icon-health-book-line', url: super_admin_instance_status_url, label: 'Instance Health' } %>
      <%= render partial: "nav_item", locals: { icon: 'icon-mail-send-fill', url: super_admin_push_diagnostics_url, label: 'Push Diagnostics' } %>
      <%= render partial: "nav_item", locals: { icon: 'icon-dashboard-line', url: '/', label: 'Agent Dashboard' } %>
      <%= render partial: "nav_item", locals: { icon: 'icon-logout-circle-r-line', url: super_admin_logout_url, label: 'Logout' } %>
    </ul>
  </div>
</div>
